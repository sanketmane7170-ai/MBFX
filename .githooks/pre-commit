#!/bin/sh
# Auto-increment the app patch version (apps/web/package.json) on every commit.
# Enable once with:  git config core.hooksPath .githooks
# Bypass for a single commit with:  git commit --no-verify

root=$(git rev-parse --show-toplevel) || exit 0
pkg="$root/apps/web/package.json"
[ -f "$pkg" ] || exit 0

node -e '
const fs = require("fs");
const p = process.argv[1];
const j = JSON.parse(fs.readFileSync(p, "utf8"));
const [a, b, c] = (j.version || "1.1.0").split(".").map((n) => parseInt(n, 10) || 0);
j.version = [a, b, c + 1].join(".");
fs.writeFileSync(p, JSON.stringify(j, null, 2) + "\n");
console.error("→ app version bumped to " + j.version);
' "$pkg" || exit 0

git add "$pkg"
exit 0
